APP_NAME=Umbralia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SCHEDULE_QUEUE_WORKER=true

CACHE_STORE=database
CACHE_PREFIX=umbralia

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

MONITORING_QUEUE_ENABLED=false
MONITORING_ALERT_EMAIL=

WHATSAPP_ENABLED=false
META_WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_LANGUAGE_ES=es
META_WHATSAPP_LANGUAGE_EN=en_US
META_WHATSAPP_TEMPLATE_PATIENT_CONFIRMATION_ES=
META_WHATSAPP_TEMPLATE_PATIENT_CONFIRMATION_EN=
META_WHATSAPP_TEMPLATE_THERAPIST_CONFIRMATION_ES=
META_WHATSAPP_TEMPLATE_THERAPIST_CONFIRMATION_EN=
META_WHATSAPP_TEMPLATE_PATIENT_REMINDER_ES=
META_WHATSAPP_TEMPLATE_PATIENT_REMINDER_EN=
META_WHATSAPP_TEMPLATE_THERAPIST_REMINDER_ES=
META_WHATSAPP_TEMPLATE_THERAPIST_REMINDER_EN=

VITE_APP_NAME="${APP_NAME}"
